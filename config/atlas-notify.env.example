# Copie para C:\auto-orcamento\config\atlas-notify.env (não versionar).
# Mesmo AUTO_ORCAMENTO_ATLAS_NOTIFY_TOKEN no CT: /etc/auto-orcamento/atlas-notify.env

AUTO_ORCAMENTO_ATLAS_NOTIFY_TOKEN=
# 0.0.0.0 = LAN + Tailscale; CT usa URL com IP LAN do Atlas (ex. 192.168.68.200).
AUTO_ORCAMENTO_ATLAS_NOTIFY_BIND_HOST=0.0.0.0
AUTO_ORCAMENTO_ATLAS_NOTIFY_PORT=3010
